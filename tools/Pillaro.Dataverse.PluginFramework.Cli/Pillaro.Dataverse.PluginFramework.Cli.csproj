<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>pillaro-dv</AssemblyName>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pillaro-dv</ToolCommandName>
    <PackageId>Pillaro.Dataverse.PluginFramework.Cli</PackageId>
    <Title>Pillaro Dataverse CLI</Title>
    <Description>Command-line tool that deploys a Microsoft Dataverse (Dynamics 365) plug-in assembly and synchronizes its plug-in step and image registrations from metadata defined in code. Bundled inside the Pillaro.Dataverse.PluginFramework package; install this package only to put pillaro-dv on PATH. Apache-2.0 licensed, free for commercial use.</Description>
    <Authors>Pillaro Labs s.r.o.</Authors>
    <Company>Pillaro Labs s.r.o.</Company>
    <Copyright>Copyright © 2026 Pillaro Labs s.r.o.</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/Pillaro-Standard/Dataverse-Plugin-Framework</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Pillaro-Standard/Dataverse-Plugin-Framework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>dataverse;dynamics-365;power-platform;dataverse-plugin;plugin-registration;deployment;cli;dotnet-tool;csharp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.10" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pillaro.Dataverse.PluginFramework\Pillaro.Dataverse.PluginFramework.csproj" />
  </ItemGroup>

  <!--
    AI instructions shipped by 'pillaro-dv ai-sync', in the version of this CLI. The resource name is
    the file's path in this repository; AiInstructionLayout decides where it lands in a solution.
  -->
  <PropertyGroup>
    <AiSourceRoot>$(MSBuildThisFileDirectory)..\..\</AiSourceRoot>
    <AiExamples>$(AiSourceRoot)examples\</AiExamples>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(AiSourceRoot)docs\ai\rules\*.md" LogicalName="ai-source/docs/ai/rules/%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(AiSourceRoot)docs\ai\analysis-workflow.md" LogicalName="ai-source/docs/ai/analysis-workflow.md" />
    <EmbeddedResource Include="$(AiSourceRoot)docs\ai\verify.md" LogicalName="ai-source/docs/ai/verify.md" />
    <EmbeddedResource Include="$(AiSourceRoot).github\instructions\*.instructions.md" LogicalName="ai-source/.github/instructions/%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(AiSourceRoot)ai\**\*.md" LogicalName="ai-source/ai/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(AiExamples)Pillaro.Dataverse.PluginFramework.Examples.Logic\Tasks\Contact\ValidateNames.cs" LogicalName="ai-source/examples/Pillaro.Dataverse.PluginFramework.Examples.Logic/Tasks/Contact/ValidateNames.cs" />
    <EmbeddedResource Include="$(AiExamples)Pillaro.Dataverse.PluginFramework.Examples.Logic\Tasks\Contact\RecordJobTitleChange.cs" LogicalName="ai-source/examples/Pillaro.Dataverse.PluginFramework.Examples.Logic/Tasks/Contact/RecordJobTitleChange.cs" />
    <EmbeddedResource Include="$(AiExamples)Pillaro.Dataverse.PluginFramework.Examples.Logic\Tasks\Contact\ArchiveDeletedContact.cs" LogicalName="ai-source/examples/Pillaro.Dataverse.PluginFramework.Examples.Logic/Tasks/Contact/ArchiveDeletedContact.cs" />
    <EmbeddedResource Include="$(AiExamples)Pillaro.Dataverse.PluginFramework.Examples.Logic\Plugins\ContactPlugin.cs" LogicalName="ai-source/examples/Pillaro.Dataverse.PluginFramework.Examples.Logic/Plugins/ContactPlugin.cs" />
    <EmbeddedResource Include="$(AiExamples)Pillaro.Dataverse.PluginFramework.Examples.Tests\Tests\Contact\ArchiveDeletedContactTests.cs" LogicalName="ai-source/examples/Pillaro.Dataverse.PluginFramework.Examples.Tests/Tests/Contact/ArchiveDeletedContactTests.cs" />
    <EmbeddedResource Include="$(AiExamples)Pillaro.Dataverse.PluginFramework.Examples.Tests\Tests\Contact\ValidateNamesTests.cs" LogicalName="ai-source/examples/Pillaro.Dataverse.PluginFramework.Examples.Tests/Tests/Contact/ValidateNamesTests.cs" />
    <EmbeddedResource Include="$(AiExamples)Pillaro.Dataverse.PluginFramework.Examples.Tests\Data\Repositories\ContactRepository.cs" LogicalName="ai-source/examples/Pillaro.Dataverse.PluginFramework.Examples.Tests/Data/Repositories/ContactRepository.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Pillaro.Dataverse.PluginFramework.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
