<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Pillaro.Dataverse.PluginTemplate.Logic</RootNamespace>
    <AssemblyName>Pillaro.Dataverse.PluginTemplate.Logic</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Not a library published for external consumption, and nothing reads the generated XML —
         requiring XML docs on every public member here just to keep PF-BUILD-001 (zero warnings)
         would burden every generated project for no reader. -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- EnableDefaultItems=false does NOT reliably cascade into EnableDefaultCompileItems (the SDK
         resolves the latter's default from the former during Sdk.props import, before this
         PropertyGroup runs) — set it explicitly, or the framework package's own
         <Compile Include="EarlyBound\**\*.cs" Condition="... EnableDefaultCompileItems == 'false'" />
         never activates and pac modelbuilder output silently never compiles into this project. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Plugins\PluginBase.cs" />
    <Compile Include="Plugins\ExamplePlugin.cs" />
    <Compile Include="Tasks\Example\ExampleTask.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pillaro.Dataverse.PluginFramework" Version="1.1.0" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" />
  </ItemGroup>
</Project>
