<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
    <Metadata>
        <Identity Id="Pillaro.Dataverse.PluginTemplate.Template" Version="1.0.64" Language="en-US" Publisher="Pillaro" />
        <DisplayName>Pillaro Dataverse Plugin Template</DisplayName>
        <Description xml:space="preserve">Creates a Microsoft Dataverse plugin solution with separate Logic, Plugins and Tests projects, built on the Pillaro Dataverse Plugin Framework. Licensed under Apache-2.0.</Description>
        <MoreInfo>https://github.com/Pillaro-Standard/Dataverse-Plugin-Framework</MoreInfo>
        <!-- One tag, max 50 characters. VsixPublisher does not split this element on
             anything: it sends the whole string as a single tag, so a comma-separated
             list fails the publish with VsixPub0023. That has now broken the
             Marketplace publish twice, in #44 and again here. The Marketplace tag list
             lives in marketplace/visualstudio-extension.publish.json instead. -->
        <Tags>dataverse</Tags>
    </Metadata>
    <Installation InstalledByMsi="false" AllUsers="false" SystemComponent="false">
        <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,19.0)">
            <ProductArchitecture>amd64</ProductArchitecture>
        </InstallationTarget>
        <InstallationTarget Id="Microsoft.VisualStudio.Professional" Version="[17.0,19.0)">
            <ProductArchitecture>amd64</ProductArchitecture>
        </InstallationTarget>
        <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.0,19.0)">
            <ProductArchitecture>amd64</ProductArchitecture>
        </InstallationTarget>
    </Installation>
    <Assets>
        <Asset Type="Microsoft.VisualStudio.ProjectTemplate" Path="ProjectTemplates" d:Source="File" d:TargetPath="ProjectTemplates\Pillaro.Dataverse.PluginTemplate.zip" />
    </Assets>
    <Prerequisites>
        <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,19.0)" DisplayName="Visual Studio core editor" />
    </Prerequisites>
</PackageManifest>
